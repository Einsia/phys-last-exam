# Conda environments — rebuilt by scripts/create_env.sh and create_track_env.sh
envs/

# Python bytecode
__pycache__/
*.py[cod]
*.pth
*.egg-info/
.ipynb_checkpoints/

# Tracker weights, HF/torch caches, vendored source, and frame handoff.
# Repopulated by scripts/fetch_tracker_weights.sh / create_track_env.sh.
cache/

# Run logs
logs/

# Local debug scratch
scratch/

# Synthetic fixtures — regenerate with scripts/make_synth_dataset.py.
# The .spec.json, manifest.json and *_summary.json alongside them stay tracked,
# as do data/videos/minimax-h3/*.mp4 (model output, not reproducible locally).
data/synthetic/*.mp4
data/videos/synthetic/*.mp4
*.mp4
*.pt
*.safetensors
*.ckpt
*.onnx
*.bin

# Generated visualizations and local run artifacts; JSON summaries/specs stay tracked.
data/first_frames/*.png
data/first_frames_synthetic/*.png
data/results/**/*.png

# Stray screenshot in a typo'd directory; safe to delete
Imges/

# Editor and OS
.vscode/
.idea/
.DS_Store

# Local Codex/agent state
.codex/
.agents/
