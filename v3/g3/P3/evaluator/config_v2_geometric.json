{
  "score_version": "continuous-0-1-v2-geometric",
  "epsilon_floor": 0.02,
  "residual_mapping": "s=1/(1+(abs(error)/t)^2)",
  "overall_aggregation": "weighted_geometric_mean",
  "dimension_weights": {
    "task": 0.15,
    "parabola": 0.15,
    "horizontal": 0.15,
    "vertical": 0.20,
    "pair_consistency": 0.35
  },
  "dimension_weight_rationale": "Pair consistency is the defining comparison in P3. Vertical dynamics receives slightly more weight than the other single-trajectory dimensions because gravity is the task's central causal law; task/apparatus, parabola and horizontal-motion evidence receive equal weights.",
  "tolerances": {
    "sync_frames": 4.0,
    "angle_error_deg": 12.0,
    "landing_level_d": 0.50,
    "camera_translation_diag": 0.020,
    "radius_cv": 0.45,
    "backend_disagreement_radii": 0.75,
    "coverage_error": 0.15,
    "parabola_rmse_d": 0.30,
    "parabola_p95_d": 0.60,
    "x_fit_rmse_d": 0.30,
    "vx_robust_cv": 0.20,
    "y_fit_rmse_d": 0.30,
    "vy_line_residual": 0.20,
    "ay_robust_cv": 0.35,
    "range_ratio_error": 0.15,
    "initial_speed_error": 0.20,
    "gravity_error": 0.30
  },
  "component_weights": {
    "task": {
      "release_sync": 0.25,
      "launch_angle": 0.25,
      "landing_level": 0.20,
      "camera_translation": 0.15,
      "track_integrity": 0.15
    },
    "parabola_per_ball": {"rmse": 0.65, "p95": 0.35},
    "horizontal_per_ball": {"x_fit_rmse": 0.60, "vx_robust_cv": 0.40},
    "vertical_per_ball": {"y_fit_rmse": 0.65, "vy_line_residual": 0.20, "ay_robust_cv": 0.15},
    "pair_consistency": {"equal_range": 0.45, "equal_initial_speed": 0.40, "gravity_symmetry": 0.15}
  },
  "invalid_policy": "overall=0 iff measurement_valid=false; diagnostic dimensions remain continuous",
  "v1_preservation": "Input JSON is immutable; every output JSON embeds score_v1_snapshot and source_json."
}
