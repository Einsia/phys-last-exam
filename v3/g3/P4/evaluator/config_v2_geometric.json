{
  "score_version": "continuous-0-1-v2-geometric",
  "epsilon_floor": 0.02,
  "residual_mapping": "s=1/(1+(abs(error)/t)^2)",
  "overall_aggregation": "weighted_geometric_mean",
  "dimension_weights": {
    "structure": 0.25,
    "monotonic_energy_loss": 0.25,
    "ballistic_arc_quality": 0.15,
    "restitution_consistency": 0.25,
    "spatial_stability": 0.10
  },
  "dimension_weight_rationale": "Bounce-count/structure, monotonic energy loss, and restitution consistency each receive 0.25 as the three defining requirements. The remaining 0.25 is split between ballistic arc quality (0.15) and spatial/camera stability (0.10).",
  "tolerances": {
    "height_monotonic_error": 0.015,
    "near_nondecreasing_fraction": 0.25,
    "time_monotonic_excess": 0.20,
    "arc_shape_rmse": 0.30,
    "apex_time_asymmetry": 0.30,
    "m1_height_time_consistency": 0.18,
    "restitution_cv": 0.35,
    "impact_x_spread_radii": 1.50,
    "arc_x_drift_radii": 2.00,
    "camera_drift_fraction": 0.020,
    "backend_disagreement_radii": 2.00
  },
  "component_weights": {
    "structure": {"complete_arc_fraction": 0.60, "track_coverage": 0.20, "track_confidence": 0.20},
    "monotonic_energy_loss": {"height_error": 0.40, "near_nondecreasing_fraction": 0.40, "time_error": 0.20},
    "ballistic_arc_quality": {"arc_shape": 0.70, "apex_symmetry": 0.30},
    "restitution_consistency": {"height_time_agreement": 0.65, "coefficient_stability": 0.35},
    "spatial_stability": {"impact_position": 0.45, "arc_horizontal_drift": 0.25, "camera": 0.15, "backend_agreement": 0.15}
  },
  "retained_continuous_components": [
    "complete_arc_fraction=min(complete_rebound_arc_count/required_rebound_arc_count,1)",
    "track_coverage=clamp(fused_coverage,0,1)",
    "track_confidence=clamp(confident_coverage,0,1)"
  ],
  "invalid_policy": "overall=0 iff measurement_valid=false; diagnostic dimensions remain continuous",
  "v1_preservation": "Input JSON is immutable; every output JSON embeds score_v1_snapshot and source_json."
}
